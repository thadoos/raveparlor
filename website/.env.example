# Canonical origin of the site (no trailing slash). Used for metadataBase, canonical/Open Graph URLs,
# sitemap.xml, robots.txt and the JSON-LD. Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL on
# Vercel, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase project (local stack: `supabase start` then `supabase status`). The URL and publishable key
# are public; the secret key bypasses RLS and must stay server-side (only the seed script uses it).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin account created by `npm run seed:content` (sign-ups are disabled).
ADMIN_EMAIL=admin@ravesparlor.test
ADMIN_PASSWORD=
